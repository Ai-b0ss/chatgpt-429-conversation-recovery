{
  "manifest_version": 3,
  "name": "ChatGPT Conversation Availability Guard",
  "version": "0.9.3",
  "description": "Mitigates transient HTTP 429 failures on ChatGPT conversation reads and captures safe diagnostics for chat-unavailable failures. Unofficial.",
  "permissions": ["storage", "webRequest"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["guard.js", "stream-observer.js", "control.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "host_permissions": ["https://chatgpt.com/*"],
  "action": {
    "default_title": "ChatGPT Conversation Availability Guard",
    "default_popup": "popup.html"
  }
}
